# =============================================================================
# RastiSi production environment  ->  install as /etc/rastisi/env
#   sudo install -o root -g rastisi -m 0640 rastisi.env.example /etc/rastisi/env
#   then EDIT every CHANGE_ME value ON THE SERVER. Never commit the edited file.
#
# This file contains placeholders only. No secret, token or password is stored
# in Git. Generate secrets on the server (commands shown next to each value).
# systemd reads it with EnvironmentFile=; shell scripts source it with `set -a`,
# so values must not contain unquoted spaces or shell metacharacters.
# Full reference of every variable:
#   docs/docs/product/deployment/PRODUCTION_CONFIGURATION.md
# =============================================================================

# ---- Django core -------------------------------------------------------------
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_DEBUG=False
# Exact hostnames only, no wildcards. These are the five hosts of this deployment.
DJANGO_ALLOWED_HOSTS=rastisi.ir,www.rastisi.ir,platformadmins.rastisi.ir,demo-v5.rastisi.ir,demo-arch02.rastisi.ir
DJANGO_CSRF_TRUSTED_ORIGINS=https://rastisi.ir,https://www.rastisi.ir,https://platformadmins.rastisi.ir,https://demo-v5.rastisi.ir,https://demo-arch02.rastisi.ir

# ---- HTTPS (nginx terminates TLS, gunicorn listens on a unix socket) ----------
# Enable the redirect only after HTTPS works for every host above.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
# Start at 0; raise gradually (3600 -> 86400 -> 31536000) once HTTPS is proven.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_PROXY_SSL_HEADER=X-Forwarded-Proto:https
# "unix" = the direct peer is a local unix-socket proxy (nginx on this host).
DJANGO_TRUSTED_PROXY_CIDRS=unix

# ---- Hosts / routing -----------------------------------------------------------
# Defaults already match production; stated explicitly so a typo is visible.
RASTISI_PLATFORM_HOSTS=rastisi.ir,www.rastisi.ir
RASTISI_PLATFORM_PRIMARY_HOST=rastisi.ir
RASTISI_PLATFORM_ADMIN_HOSTS=platformadmins.rastisi.ir
RASTISI_ADMIN_DOMAIN_SUFFIX=rastisi.ir

# ---- Database: DEDICATED PostgreSQL database + role for RastiSi ---------------
# Never point this at a database or role that rastiservice.ir uses.
#   postgres://rastisi_app:<password>@127.0.0.1:5432/rastisi
DATABASE_URL=postgres://rastisi_app:CHANGE_ME@127.0.0.1:5432/rastisi

# ---- Shared rate-limit cache (required in production) -------------------------
# Prefer a DEDICATED Redis instance/port for RastiSi. If you must share a Redis
# server with another site, use a different database number AND a password, and
# never run FLUSHALL/FLUSHDB against it.
RASTISI_RATE_LIMIT_CACHE_URL=redis://:CHANGE_ME@127.0.0.1:6380/0

# ---- Cloudflare Turnstile (fail-closed in production) -------------------------
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
TURNSTILE_EXPECTED_HOSTNAMES=rastisi.ir,www.rastisi.ir,platformadmins.rastisi.ir
TURNSTILE_VERIFY_TIMEOUT_SECONDS=5

# ---- Files ---------------------------------------------------------------------
DJANGO_STATIC_ROOT=/var/www/rastisi/staticfiles
DJANGO_MEDIA_ROOT=/var/www/rastisi/media
DJANGO_PRIVATE_MEDIA_ROOT=/var/lib/rastisi/private_media

# ---- Payment credential encryption (required when DEBUG=False) -----------------
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_CREDENTIAL_KEY=CHANGE_ME

# ---- Mail / SMS (optional until you enable the feature) ------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=no-reply@rastisi.ir
RASTISI_OWNER_SMS_BACKEND=console

# ---- Logging -------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
